{
  "datasets": [
    {
      "name": "ds_resumo",
      "displayName": "Resumo por camada × status",
      "queryLines": [
        "SELECT camada_titulo AS camada, status, count(*) AS indicadores FROM ops.v_sanidade_status GROUP BY ALL\n"
      ]
    },
    {
      "name": "ds_portao",
      "displayName": "Portão de envio",
      "queryLines": [
        "SELECT count_if(status = 'ALERTA' AND bloqueia_envio) AS bloqueios_de_envio,\n",
        "       count_if(status = 'ALERTA') AS indicadores_em_alerta FROM ops.v_sanidade_status\n"
      ]
    },
    {
      "name": "ds_norte",
      "displayName": "Índice-norte e fatores (última competência)",
      "queryLines": [
        "SELECT competencia, round(100 * MEASURE(indice_norte), 2) AS indice_norte_pct,\n",
        "       round(100 * MEASURE(atingimento_meta), 1) AS atingimento_meta_pct,\n",
        "       MEASURE(economia_efetivada) AS economia_efetivada\n",
        "FROM semantic.mv_funil_economia GROUP BY competencia ORDER BY competencia DESC LIMIT 1\n"
      ]
    },
    {
      "name": "ds_fatores",
      "displayName": "Fatores do norte (M21 × M22 × M23 × M24 × M18)",
      "queryLines": [
        "SELECT etapa, round(100 * taxa, 2) AS taxa_pct FROM (\n",
        "  SELECT competencia, MEASURE(taxa_identificacao) AS identificacao, MEASURE(taxa_ativacao) AS ativacao,\n",
        "         MEASURE(taxa_envio) AS envio, MEASURE(taxa_registro) AS registro, MEASURE(taxa_efetivacao) AS efetivacao\n",
        "  FROM semantic.mv_funil_economia GROUP BY competencia ORDER BY competencia DESC LIMIT 1) f\n",
        "LATERAL VIEW stack(5, '1 identificação', identificacao, '2 ativação', ativacao, '3 envio', envio,\n",
        "                      '4 registro', registro, '5 efetivação', efetivacao) s AS etapa, taxa\n"
      ]
    },
    {
      "name": "ds_glosa_regra",
      "displayName": "Glosa por regra",
      "queryLines": [
        "SELECT regra_principal, MEASURE(valor_glosado) AS valor_glosado, MEASURE(itens_glosados) AS itens_glosados\n",
        "FROM semantic.mv_auditoria_glosa WHERE regra_principal IS NOT NULL GROUP BY regra_principal\n"
      ]
    },
    {
      "name": "ds_pr_total",
      "displayName": "Precisão e recall (gabarito do case)",
      "queryLines": [
        "SELECT round(100 * precisao, 1) AS precisao_pct, round(100 * recall, 1) AS recall_pct,\n",
        "       concat(format_number(100 * precisao_ic_inf, 1), '% – ', format_number(100 * precisao_ic_sup, 1), '%') AS precisao_ic95,\n",
        "       concat(format_number(100 * recall_ic_inf, 1), '% – ', format_number(100 * recall_ic_sup, 1), '%') AS recall_ic95,\n",
        "       round(100 * precisao_rs, 1) AS precisao_rs_pct, round(100 * recall_rs_limite_inferior, 1) AS recall_rs_li_pct,\n",
        "       tp, fp, fn, tn, itens_rotulados\n",
        "FROM ops.v_precisao_recall WHERE recorte = 'total'\n"
      ]
    },
    {
      "name": "ds_pr_matriz",
      "displayName": "Matriz de confusão",
      "queryLines": [
        "SELECT resultado, CASE resultado WHEN 'TP' THEN 'Glosou e era indevido' WHEN 'FP' THEN 'Glosou, mas era devido'\n",
        "                                 WHEN 'FN' THEN 'Não glosou, mas era indevido' ELSE 'Não glosou e era devido' END AS significado,\n",
        "       count(*) AS itens, round(sum(CASE WHEN resultado IN ('TP', 'FP') THEN vl_glosado ELSE vl_cobrado END), 2) AS valor_rs\n",
        "FROM gold.v_avaliacao_gabarito WHERE rotulado GROUP BY resultado\n",
        "ORDER BY CASE resultado WHEN 'TP' THEN 1 WHEN 'FP' THEN 2 WHEN 'FN' THEN 3 ELSE 4 END\n"
      ]
    },
    {
      "name": "ds_pr_regra",
      "displayName": "Precisão por regra",
      "queryLines": [
        "SELECT recorte AS regra, tp, fp, round(100 * precisao, 1) AS precisao_pct,\n",
        "       concat(format_number(100 * precisao_ic_inf, 1), '% – ', format_number(100 * precisao_ic_sup, 1), '%') AS ic95,\n",
        "       CASE WHEN precisao_ic_inf >= 0.95 THEN 'atinge o piso de 95%' ELSE 'abaixo do piso de 95% (amostra pequena)' END AS piso_envio\n",
        "FROM ops.v_precisao_recall WHERE ordem = 1 ORDER BY recorte\n"
      ]
    },
    {
      "name": "ds_ia_serie",
      "displayName": "IA por dia",
      "queryLines": [
        "SELECT dia, concat(task_id, ' · ', adapter) AS tarefa_adapter, taxa_schema_valido, custo_estimado_usd, latencia_p95_ms\n",
        "FROM ops.v_ia_sanidade\n"
      ]
    },
    {
      "name": "ds_status_negocio",
      "displayName": "Status · Negócio",
      "queryLines": [
        "SELECT status, id_indicador, nome, recorte, CAST(round(valor, 4) AS STRING) AS valor, CAST(round(banda_min, 4) AS STRING) AS banda_min, CAST(round(banda_max, 4) AS STRING) AS banda_max, severidade, dono, runbook, acao, ordem FROM ops.v_sanidade_status WHERE camada = 'negocio'\n",
        "ORDER BY CASE status WHEN 'ALERTA' THEN 0 WHEN 'SEM_DADO' THEN 1 WHEN 'CALIBRANDO' THEN 2 WHEN 'SEM_FONTE' THEN 3 ELSE 4 END,\n",
        "         ordem, recorte\n"
      ]
    },
    {
      "name": "ds_status_semantica",
      "displayName": "Status · Aderência semântica",
      "queryLines": [
        "SELECT status, id_indicador, nome, recorte, CAST(round(valor, 4) AS STRING) AS valor, CAST(round(banda_min, 4) AS STRING) AS banda_min, CAST(round(banda_max, 4) AS STRING) AS banda_max, severidade, dono, runbook, acao, ordem FROM ops.v_sanidade_status WHERE camada = 'semantica'\n",
        "ORDER BY CASE status WHEN 'ALERTA' THEN 0 WHEN 'SEM_DADO' THEN 1 WHEN 'CALIBRANDO' THEN 2 WHEN 'SEM_FONTE' THEN 3 ELSE 4 END,\n",
        "         ordem, recorte\n"
      ]
    },
    {
      "name": "ds_status_dados",
      "displayName": "Status · Engenharia de dados",
      "queryLines": [
        "SELECT status, id_indicador, nome, recorte, CAST(round(valor, 4) AS STRING) AS valor, CAST(round(banda_min, 4) AS STRING) AS banda_min, CAST(round(banda_max, 4) AS STRING) AS banda_max, severidade, dono, runbook, acao, ordem FROM ops.v_sanidade_status WHERE camada = 'dados'\n",
        "ORDER BY CASE status WHEN 'ALERTA' THEN 0 WHEN 'SEM_DADO' THEN 1 WHEN 'CALIBRANDO' THEN 2 WHEN 'SEM_FONTE' THEN 3 ELSE 4 END,\n",
        "         ordem, recorte\n"
      ]
    },
    {
      "name": "ds_status_ia",
      "displayName": "Status · IA",
      "queryLines": [
        "SELECT status, id_indicador, nome, recorte, CAST(round(valor, 4) AS STRING) AS valor, CAST(round(banda_min, 4) AS STRING) AS banda_min, CAST(round(banda_max, 4) AS STRING) AS banda_max, severidade, dono, runbook, acao, ordem FROM ops.v_sanidade_status WHERE camada = 'ia'\n",
        "ORDER BY CASE status WHEN 'ALERTA' THEN 0 WHEN 'SEM_DADO' THEN 1 WHEN 'CALIBRANDO' THEN 2 WHEN 'SEM_FONTE' THEN 3 ELSE 4 END,\n",
        "         ordem, recorte\n"
      ]
    }
  ],
